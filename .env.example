# ============================================================================
# FONDATION MARIE-HÉLÈNE MUVARO — Variables d'environnement (MODÈLE)
#
# 1. Copier vers `.env` : cp .env.example .env
# 2. Renseigner des valeurs propres à l'environnement.
# 3. NE JAMAIS COMMITER `.env` NI PUBLIER DE VRAIES CLÉS.
# ============================================================================

# --- Base de données PostgreSQL (obligatoire) --------------------------------
DATABASE_URL="postgresql://fmhm:CHANGE_ME@localhost:5432/fmhm?schema=public"

# --- Application --------------------------------------------------------------
# URL publique (métadonnées, sitemap, liens canoniques).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# --- Authentification (obligatoire) ------------------------------------------
# Secret de signature des sessions. Générer une valeur aléatoire forte :
#   openssl rand -base64 48
AUTH_SECRET=""
# Jeton obligatoire pour la première installation en production.
#   openssl rand -hex 32
ADMIN_SETUP_TOKEN=""
# Faire confiance au proxy inverse pour l'IP cliente (rate-limit).
# 0 = pas de proxy ou proxy non configuré ; 1 = X-Forwarded-For fiable.
TRUST_PROXY="0"

# --- Référencement ------------------------------------------------------------
# 0 = noindex (préproduction / validation) ; 1 = indexation publique autorisée.
PUBLIC_INDEXING="0"

# --- Stockage privé -----------------------------------------------------------
# Dossier hors racine publique. En production : volume persistant, ex. /data/storage.
STORAGE_DIR="./storage/private"
MAX_UPLOAD_MB="10"

# --- Paiements ----------------------------------------------------------------
# Aucune passerelle activée par défaut. Les secrets prestataires seront ajoutés
# uniquement après contrat, autorisation explicite et intégration vérifiée.
# Ne jamais stocker de données de carte bancaire.
# MPESA_ENABLED="0"
# AIRTEL_MONEY_ENABLED="0"
# ORANGE_MONEY_ENABLED="0"
# INTERNATIONAL_ENABLED="0"
