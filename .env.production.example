# ============================================================================
# MODÈLE POUR LA PRODUCTION (VPS Linux + docker-compose.prod.yml)
#
# 1. Copier vers `.env` sur le serveur :  cp .env.production.example .env
# 2. Remplacer toutes les valeurs CHANGE_ME par des secrets forts :
#      openssl rand -base64 48     # AUTH_SECRET
#      openssl rand -hex 32        # ADMIN_SETUP_TOKEN
#      openssl rand -hex 24        # POSTGRES_PASSWORD (caractères alphanumériques)
# 3. chmod 600 .env — ne jamais le committer ni le publier.
#
# IMPORTANT : dans Docker, la base est joignable par le nom de service `db`,
# jamais par `localhost`. DATABASE_URL est dérivée automatiquement des
# variables POSTGRES_* ci-dessous ; ne la surcharger que si vous utilisez une
# base externe.
# ============================================================================

# --- PostgreSQL (conteneur db) ----------------------------------------------
POSTGRES_USER="fmhm"
POSTGRES_PASSWORD="CHANGE_ME_mot_de_passe_aleatoire"
POSTGRES_DB="fmhm"

# Surcharge optionnelle, uniquement pour une base externe :
# DATABASE_URL="postgresql://utilisateur:motdepasse@hote:5432/base?schema=public"

# --- Application -------------------------------------------------------------
# Domaine public réel, en HTTPS (obligatoire pour les cookies sécurisés).
NEXT_PUBLIC_SITE_URL="https://CHANGE_ME.example.org"

# --- Secrets applicatifs -----------------------------------------------------
AUTH_SECRET="CHANGE_ME_openssl_rand_base64_48"
# Jeton exigé par /installation en production. À retirer du fichier après
# la création du premier compte si vous le souhaitez.
ADMIN_SETUP_TOKEN="CHANGE_ME_openssl_rand_hex_32"

# --- Réseau et indexation ----------------------------------------------------
# 1 uniquement derrière un reverse proxy qui définit X-Forwarded-For.
TRUST_PROXY="1"
# 0 = noindex (tant que la Fondation n'a pas validé la mise en ligne).
PUBLIC_INDEXING="0"

# --- Stockage ----------------------------------------------------------------
# Le volume Docker fmhm_storage est monté sur /data/storage ; ne pas changer
# STORAGE_DIR ici sans adapter docker-compose.prod.yml.
MAX_UPLOAD_MB="10"
